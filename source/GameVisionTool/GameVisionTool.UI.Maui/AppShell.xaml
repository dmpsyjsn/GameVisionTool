<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="GameVisionTool.UI.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:GameVisionTool.UI.Maui"
    xmlns:views="using:GameVisionTool.UI.Maui.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="GameVisionTool.UI.Maui">

    <TabBar x:Name="MainTabBar">
        <ShellContent
            Title="Home"
            Icon="home.png"
            ContentTemplate="{DataTemplate views:MainPage}"
            Route="MainPage" />

        <!-- No Icon on these two: there is no image in Resources/Images for them yet. -->
        <ShellContent
            Title="Ideas"
            ContentTemplate="{DataTemplate views:Ideas}"
            Route="Ideas" />

        <!-- One tab per AgentGroupType is inserted here at runtime - see AppShell.xaml.cs. Each
             uses its matching Views type (e.g. Backstory) if one exists, otherwise falls back to
             WorkInProgress. -->

        <ShellContent
            Title="Settings"
            Icon="main_settings.jpg"
            ContentTemplate="{DataTemplate views:MainSettings}"
            Route="Settings" />

        <ShellContent
            Title="Agents"
            ContentTemplate="{DataTemplate views:Agents}"
            Route="Agents" />
    </TabBar>

</Shell>
