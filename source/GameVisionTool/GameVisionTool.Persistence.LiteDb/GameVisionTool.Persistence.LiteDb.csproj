<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    This project owns the only LiteDB PackageReference in the solution. GameVisionTool.Logic
    deliberately does NOT reference LiteDB, so a handler that tries to use ILiteDatabase
    directly fails to compile (CS0246) instead of quietly bypassing IDataStore.
  -->
  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" PrivateAssets="compile" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameVisionTool.Common.Domain\GameVisionTool.Common.Domain.csproj" />
  </ItemGroup>

</Project>
