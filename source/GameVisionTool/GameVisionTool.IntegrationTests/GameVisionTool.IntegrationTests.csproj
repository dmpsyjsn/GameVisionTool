<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <!-- The policy tests use Serilog's IDestructuringPolicy and LogEventPropertyValue directly, so
         the package is declared here rather than relied on transitively through Logic. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameVisionTool.Common.Domain\GameVisionTool.Common.Domain.csproj" />
    <!-- The Llama handler tests name ILlamaAgent and ILlamaModelProvider directly, so the project is
         declared here rather than relied on transitively through Logic. -->
    <ProjectReference Include="..\GameVisionTool.Integration.LlamaSharp\GameVisionTool.Integration.LlamaSharp.csproj" />
    <ProjectReference Include="..\GameVisionTool.Logic\GameVisionTool.Logic.csproj" />
    <ProjectReference Include="..\GameVisionTool.Persistence.LiteDb\GameVisionTool.Persistence.LiteDb.csproj" />
  </ItemGroup>

</Project>
